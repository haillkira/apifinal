@implements IDisposable
@using Inmobiliaria.Web.Services
@inject SesionUsuario Sesion
@inject NavigationManager Nav
<div class="nav-shell">
<a class="brand" href="/">inmobiliaria<span>●</span></a>
<button class="menu-toggle" aria-label="Abrir navegación" aria-expanded="@abierto" @onclick="() => abierto = !abierto">Menú ☰</button>
<nav class="@(abierto ? "site-nav open" : "site-nav")" aria-label="Principal">
<NavLink href="/" Match="NavLinkMatch.All" @onclick="Cerrar">Inicio</NavLink>
<NavLink href="/publicaciones" @onclick="Cerrar">Explorar alquileres</NavLink>
@if(Sesion.Usuario?.Rol == "Vendedor") { <NavLink href="/mis-propiedades" @onclick="Cerrar">Mis propiedades</NavLink><NavLink href="/archivo" @onclick="Cerrar">Administrar</NavLink> }
@if(Sesion.Usuario?.Rol is "Comprador" or "Vendedor") { <NavLink href="/mis-solicitudes" @onclick="Cerrar">Solicitudes</NavLink> }
<div class="nav-account">
@if(Sesion.EstaAutenticado) { <span class="account-name">@Sesion.Usuario?.Nombre <small>@Sesion.Usuario?.Rol</small></span><button class="btn btn-outline-primary btn-sm" @onclick="Salir">Salir</button> }
else { <NavLink href="/login" @onclick="Cerrar">Iniciar sesión</NavLink><NavLink class="btn btn-primary" href="/registro/vendedor" @onclick="Cerrar">Publicar propiedad ↗</NavLink> }
</div></nav></div>
@code {
 bool abierto;
 void Cerrar() => abierto = false;
 protected override void OnInitialized() => Sesion.Cambio += Refrescar;
 void Refrescar() => InvokeAsync(StateHasChanged);
 void Salir() { Sesion.Cerrar(); Cerrar(); Nav.NavigateTo("/"); }
 public void Dispose() => Sesion.Cambio -= Refrescar;
}
