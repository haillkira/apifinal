@page "/login"
@using Inmobiliaria.Web.Models
@using Inmobiliaria.Web.Services
@inject InmobiliariaApi Api
@inject SesionUsuario Sesion
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<h1>Iniciar sesión</h1>
<p class="text-center">Tu próximo hogar y tus solicitudes, en un solo lugar.</p>

<div class="col-md-5">
    <EditForm Model="modelo" OnValidSubmit="Entrar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (error is not null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="mb-3">
            <label class="form-label">Correo</label>
            <InputText class="form-control" @bind-Value="modelo.Correo" />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <InputText type="password" class="form-control" @bind-Value="modelo.Password" />
        </div>
        <button class="btn btn-primary" disabled="@enviando">Entrar</button>
        <p class="mt-4 mb-0 small">¿Aún no tienes cuenta? <a href="/registro/comprador">Regístrate aquí</a></p>
    </EditForm>
</div>

@code {
    private LoginModelo modelo = new();
    private string? error;
    private bool enviando;

    private async Task Entrar()
    {
        enviando = true;
        error = null;
        try
        {
            var (datos, mensaje) = await Api.LoginAsync(modelo.Correo, modelo.Password);
            if (datos is null) { error = mensaje; return; }
            Sesion.Iniciar(datos);
            Nav.NavigateTo(datos.Usuario.Rol == "Vendedor" ? "/mis-propiedades" : "/publicaciones");
        }
        catch (HttpRequestException) { error = "No se pudo conectar. Inténtalo de nuevo."; }
        catch (TaskCanceledException) { error = "La conexión tardó demasiado. Inténtalo de nuevo."; }
        finally { enviando = false; }
    }
}
